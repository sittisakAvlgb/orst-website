{
  "name": "orst-website",
  "private": true,
  "description": "Bilingual website for the Office of the Royal Society (สำนักงานราชบัณฑิตยสภา)",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node --watch-path=src --watch-path=assets/css --watch-path=assets/js scripts/build.mjs",
    "serve": "node scripts/serve.mjs 5187",
    "package": "node scripts/build.mjs && node scripts/package.mjs"
  }
}
